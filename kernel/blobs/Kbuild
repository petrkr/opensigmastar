# Vendor modules relinked by scripts/relink.py (make relink)
ccflags-y += -I$(src)/../compat

define osm_blob
obj-m += $(1).o
$(1)-y := $(1)_wrap.o $(1)_blob.o
endef

OSM_BLOBS ?= mhal mi_common mi_sys
$(foreach b,$(OSM_BLOBS),$(eval $(call osm_blob,$(b))))

# mhal CMDQ shim (make CMDQ=shim, scripts/relink.py --cmdq shim)
ifeq ($(OSM_CMDQ),shim)
mhal-y += mhal_cmdq_shim.o
endif

# mhal VIF/CSI shim / own implementation (make VIF=shim|own, scripts/relink.py --vif)
ifeq ($(OSM_VIF),shim)
mhal-y += mhal_vif_shim.o
endif
ifeq ($(OSM_VIF),own)
mhal-y += mhal_vif_own.o
endif

# mhal SCL shim / own implementation (make SCL=shim|own, scripts/relink.py --scl)
ifeq ($(OSM_SCL),shim)
mhal-y += mhal_scl_shim.o
endif
ifeq ($(OSM_SCL),own)
mhal-y += mhal_scl_own.o
endif
