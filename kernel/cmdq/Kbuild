# osm_cmdq: replacement for the CMDQ engine code of the mhal blob, built for
# make CMDQ=own (scripts/relink.py --cmdq own). The shim variant
# (CMDQ=shim) is part of mhal, see ../blobs/mhal_cmdq_shim.c.
# vendor (default): the blob implementation, no osm_cmdq.
ccflags-y += -I$(src)/../compat -I$(src)/../sstar/include

ifeq ($(OSM_CMDQ),own)
obj-m += osm_cmdq.o
osm_cmdq-y := osm_cmdq_drv.o
endif
