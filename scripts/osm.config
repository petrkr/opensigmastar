# Kernel options added to the build for the vendor modules (debugging aids)
CONFIG_DEBUG_KERNEL=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_NETCONSOLE=y
# the vendor 4.9 kernel was fully preemptible; vendor threads poll in loops
CONFIG_PREEMPT=y
